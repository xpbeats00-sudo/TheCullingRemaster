{
  "name": "culling-remaster-launcher",
  "productName": "The Culling Remaster",
  "version": "1.3.3",
  "description": "Installs, updates, repairs and launches The Culling Remaster.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "stamp": "node tools/stamp_build.js",
    "test": "node test/sync.test.js && node test/config.test.js && node test/game.test.js && node test/playername.test.js && node test/update.test.js && node test/errors.test.js && node test/account.test.js && node test/selfupdate.test.js && node test/discord.test.js && node test/ui.test.js && node test/status.test.js && node test/reconnect.test.js && node test/serial.test.js && node test/main.test.js",
    "manifest": "node tools/make_manifest.js",
    "dist": "npm run stamp && electron-builder --win nsis"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  },
  "author": "XP Lab",
  "build": {
    "appId": "shop.xplab.cullingremaster",
    "productName": "The Culling Remaster",
    "copyright": "The Culling Remaster",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "build-info.json",
      "lib/**",
      "src/**",
      "!src/dev-mock.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "The Culling Remaster",
      "artifactName": "TheCullingRemasterSetup.exe",
      "installerIcon": "src/assets/icon.ico",
      "uninstallerIcon": "src/assets/icon.ico",
      "runAfterFinish": true
    },
    "afterPack": "tools/after_pack.js"
  }
}
